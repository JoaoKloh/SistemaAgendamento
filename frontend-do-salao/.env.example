# Copie para ".env.local" (gitignored) e ajuste os valores.

# URL base da API do backend (sem barra final), usada nos rewrites de /api/*
# e nas chamadas diretas ao backend.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Client ID do OAuth2 do Google (deve ser o mesmo configurado no backend).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
